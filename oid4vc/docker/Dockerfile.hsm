# HSM variant of docker/Dockerfile: adds the kmslite plugin plus the ACA-Py build that
# provides SignerRegistry. Released acapy-agent 1.7.0 has no signer_registry module, and
# kmslite imports it at module scope, so the fork is required rather than optional.

# isomdl-uniffi below only ships an x86_64 wheel; podman-compose doesn't forward --platform, so pin it here
FROM --platform=linux/amd64 python:3.13-slim-bookworm AS base
WORKDIR /usr/src/app

# Install and configure poetry
USER root

# Install and configure poetry
WORKDIR /usr/src/app
ENV POETRY_VERSION=2.1.2
ENV POETRY_HOME=/opt/poetry
# git for the VCS install below; build-essential to compile the python-pkcs11 extension
RUN apt-get update && apt-get install -y curl jq git build-essential && apt-get clean
RUN curl -sSL https://install.python-poetry.org | python -

ENV PATH="/opt/poetry/bin:$PATH"
RUN poetry config virtualenvs.in-project true

# Setup project
RUN mkdir oid4vc && touch oid4vc/__init__.py
RUN mkdir jwt_vc_json && touch jwt_vc_json/__init__.py
RUN mkdir sd_jwt_vc && touch sd_jwt_vc/__init__.py
RUN mkdir mso_mdoc && touch mso_mdoc/__init__.py
RUN mkdir status_list && touch status_list/__init__.py
RUN mkdir kmslite && touch kmslite/__init__.py
RUN mkdir mso_mdoc/isomdl
COPY pyproject.toml poetry.lock README.md ./
RUN poetry install --without dev --all-extras

# Replaces the acapy-agent resolved from poetry.lock, so it must run after poetry install.
ARG ACAPY_REPO=https://github.com/weiiv/acapy.git
ARG ACAPY_REF=kmslite
RUN poetry run pip install --no-cache-dir \
        "acapy-agent @ git+${ACAPY_REPO}@${ACAPY_REF}" \
        "python-pkcs11>=0.7.0,<0.8.0"

USER $user

FROM --platform=linux/amd64 python:3.13-bookworm

ARG TARGETARCH

WORKDIR /usr/src/app
COPY --from=base /usr/src/app/.venv /usr/src/app/.venv
ENV PATH="/usr/src/app/.venv/bin:$PATH"
RUN apt-get update && apt-get install -y curl jq && apt-get clean
COPY jwt_vc_json/ jwt_vc_json/
COPY mso_mdoc/ mso_mdoc/
COPY sd_jwt_vc/ sd_jwt_vc/
COPY oid4vc/ oid4vc/
ADD https://github.com/openwallet-foundation/acapy-plugins.git#main:status_list/status_list/ status_list/
ARG KMSLITE_REF=kmslite
ADD https://github.com/weiiv/acapy-plugins.git#${KMSLITE_REF}:kmslite/kmslite/ kmslite/
COPY docker/*.yml ./


# Using isomdl library from indicio
RUN if [ "$TARGETARCH" = "amd64" ]; then \
        pip install --no-cache-dir https://github.com/Indicio-tech/isomdl-uniffi/releases/download/v0.1.0-indicio.1/isomdl_uniffi-0.1.0-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
        pip install --no-cache-dir https://github.com/Indicio-tech/isomdl-uniffi/releases/download/v0.1.0-indicio.1/isomdl_uniffi-0.1.0-py3-none-macosx_11_0_arm64.whl; \
    else \
        echo "Unsupported architecture: $TARGETARCH"; \
        exit 1; \
    fi


ENTRYPOINT ["/bin/bash", "-c", "aca-py \"$@\"", "--"]
CMD ["start", "--arg-file", "default.yml"]
